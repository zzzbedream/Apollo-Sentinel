# Private key used by Hardhat to deploy contracts
DEPLOYER_PRIVATE_KEY=TU_PRIVATE_KEY_AQUI

# Private key used by the backend signer/oracle to execute decisions on-chain
BACKEND_SIGNER_PRIVATE_KEY=

# RPC endpoint for HashKey Testnet or Sepolia
TESTNET_RPC_URL=

# Fill these after running scripts/deploy-testnet.js
CONTRACT_ADDRESS_APOLLO_SENTINEL=
CONTRACT_ADDRESS_MOCK_USDT=
CONTRACT_ADDRESS_ZKID=

# Frontend origin used by server-side logic when needed (e.g. allowlist/CORS)
FRONTEND_URL=http://localhost:3000

# Optional values for contract verification on explorers
TESTNET_CHAIN_ID=
ETHERSCAN_API_KEY=
TESTNET_EXPLORER_API_KEY=
TESTNET_EXPLORER_API_URL=
TESTNET_EXPLORER_BROWSER_URL=
